PORT=18876
BIND_ADDRESS=127.0.0.1
# Optional outbound proxy reachable FROM THE CONTAINER, not host loopback:
# OUTBOUND_PROXY=http://host.docker.internal:7897

# Required for the account administration page and runtime concurrency settings.
CODEX_WORKER_QUEUE=1
# Maximum concurrency selectable in the page (changing this capacity requires recreate).
CODEX_SESSION_POOL_SIZE=32
# Availability recovery after one successful check; unknown remote work may overlap.
CODEX_WORKER_QUEUE_AUTO_RECOVER=0
CODEX_WORKER_QUEUE_MAX_RUNNING=2
CODEX_WORKER_QUEUE_GAP_MS=800
CODEX_WORKER_QUEUE_USER_GAP_MS=1500
CODEX_WORKER_QUEUE_TOOL_GAP_MS=300
CODEX_WORKER_QUEUE_START_GAP_MS=300
CODEX_WORKER_QUEUE_IDLE_TTL_SECS=900
# Automatically activate the next profile after confirmed account exhaustion.
CODEX_WORKER_AUTO_SWITCH=0
